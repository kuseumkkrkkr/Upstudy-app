{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookData V2 coordinatePoint registered activity",
  "description": "Definition only. Runtime additionally requires integer JSON tokens, not decimal 2.0, to match the Dart integer model. Requires BookData schema_version=2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "prompt", "x", "y"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
    "kind": {"const": "coordinatePoint"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "hints": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}},
    "x": {"type": "integer", "minimum": -5, "maximum": 5},
    "y": {"type": "integer", "minimum": -5, "maximum": 5}
  }
}
