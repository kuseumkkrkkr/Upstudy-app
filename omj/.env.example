# PostgreSQL: 문제 payload와 최근 풀이 이력 영속 저장소
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://omj:replace-with-a-long-random-secret@127.0.0.1:5432/omj
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_POOL_ACQUIRE_TIMEOUT_SEC=10
POSTGRES_DUAL_WRITE_WORKERS=4
POSTGRES_DUAL_WRITE_QUEUE_SIZE=2000
POSTGRES_CONNECT_RETRY_SEC=5
# PostgreSQL 이관과 검증이 끝난 뒤에만 postgres로 설정한다. 미설정 시 기존 SQLite 읽기 경로를 유지한다.
PROBLEM_CACHE_BACKEND=postgres
PROBLEM_DUAL_WRITE_ENABLED=true
MARKETPLACE_BACKEND=postgres
# migrate_problem_cache_to_postgres.py --verify-only가 통과한 배포에서만 true로 바꾼다.
PROBLEM_CACHE_VERIFIED=false

# 레벨테스트 문제는 일반 문제은행과 분리된 읽기 전용 SQLite만 사용한다.
# 비워 두면 omj/data/level_test_static.db를 사용한다.
LEVEL_TEST_STATIC_DB_PATH=

# Redis: 사용자별 최근 제공 기록, payload 캐시, 활성 풀이·급상승 통계
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_RETRY_SEC=5
REDIS_MAXMEMORY=512mb

# 상용 웹 프로세스는 false, 별도 `python -m services.jobs.worker_main` 프로세스는 작업을 전담한다.
RUN_EMBEDDED_BACKGROUND_WORKERS=false
CODEBASE_POOL_WARMUP_ENABLED=false
WORKER_CODEBASE_POOL_WARMUP_ENABLED=true
RUN_WORKER_MAINTENANCE=true

# 풀이 OCR: 모든 난이도에서 TexTeller 수식 그리드 엔진을 먼저 사용한다.
# 실패·포화·비정상 출력일 때만 Qwen 비전 OCR을 한 번 호출한다.
OMJ_OCR_QWEN_MODEL=fw-qwen3.7-plus
OCR_TEXTELLER_ENABLED=true
OCR_TEXTELLER_WARMUP_ON_STARTUP=true
OCR_TEXTELLER_MAX_CONCURRENT=1
OCR_TEXTELLER_QUEUE_TIMEOUT_SECONDS=0.05
OCR_TEXTELLER_BATCH_SIZE=4
OCR_TEXTELLER_CACHE_MAX_ENTRIES=256
OCR_TEXTELLER_CACHE_TTL_SECONDS=300
OCR_TEXTELLER_MAX_GRIDS=8
OCR_TEXTELLER_MAX_STROKES=2000
OCR_TEXTELLER_MAX_POINTS_PER_STROKE=4096
OCR_TEXTELLER_MAX_TOTAL_POINTS=200000
OCR_TEXTELLER_MAX_IMAGE_PIXELS=12000000
OCR_TEXTELLER_MAX_TOKENS=192
OCR_GRID_BASELINE_TOLERANCE=24
OCR_GRID_EXPRESSION_GAP=72
OCR_GRID_STRUCTURE_GAP=52
OCR_GRID_PADDING=12
OCR_USE_CUDA=1
# 배포 이미지에서 scripts/prefetch_texteller.py 실행을 마친 뒤에는 1로 설정할 수 있다.
HF_HUB_OFFLINE=0
