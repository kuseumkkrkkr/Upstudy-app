                  "initial_exponent": 2.0,
                  "min_exponent": -2.0,
                  "max_exponent": 2.0,
                  "step": 0.25
                }
              }
            }
          ]
        },
        {
          "id": "m10106-example",
          "template": "example",
          "title": "예제와 풀이",
          "blocks": [
            {
              "type": "question",
              "title": "예제",
              "text": "f(x)=2^x와 g(x)=log₂x에 대하여 f(3), g(8)을 구하고 두 함수의 관계를 설명하세요."
