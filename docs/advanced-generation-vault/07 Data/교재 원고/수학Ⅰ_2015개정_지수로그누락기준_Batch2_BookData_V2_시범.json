      ],
      "pages": [
        {
          "id": "m10104-open",
          "template": "opening",
          "title": "질문에서 시작하기",
          "blocks": [
            {
              "type": "lead",
              "title": "오늘의 질문",
              "text": "log₂(8·4)와 log₂(8)+log₂(4)가 같은 값을 갖는지 성질과 계산으로 확인하세요."
            },
            {
              "type": "thinking",
              "title": "먼저 생각하기",
              "text": "밑과 진수의 조건을 표시하고, 지수식과 로그식 사이의 대응을 예상합니다."
            }
          ]
        },
        {
          "id": "m10104-concept",
          "template": "concept",
          "title": "로그의 성질과 계산",
          "blocks": [
            {
              "type": "definition",
              "title": "핵심 개념",
              "text": "a>0, a≠1이고 M,N>0일 때 log_a(MN)=log_a M+log_a N, log_a(M/N)=log_a M−log_a N, log_a(M^r)=r log_a M입니다. 이 성질은 log_a M=x를 a^x=M으로 바꾸어 지수법칙을 적용하면 얻습니다. 밑과 진수 조건을 먼저 확인합니다."
            },
            {
              "type": "formula",
              "title": "공식 기준",
              "text": "12수학Ⅰ01-04"
            },
            {
              "type": "misconception",
              "title": "조건 확인",
              "text": "밑의 범위와 진수의 양수 조건을 먼저 확인한 뒤 식을 변형하세요."
            }
          ]
        },
        {
          "id": "m10104-example",
          "template": "example",
          "title": "예제와 풀이",
          "blocks": [
            {
              "type": "question",
              "title": "예제",
              "text": "log₂(8·4)와 log₂(8)+log₂(4)가 같은 값을 갖는지 성질과 계산으로 확인하세요."
            },
            {
              "type": "solutionStep",
              "title": "풀이",
              "items": [
                "곱의 로그 성질에 따르면 log₂(8·4)=log₂8+log₂4입니다.",
                "8=2³, 4=2²이므로 오른쪽은 3+2=5입니다.",
                "왼쪽도 8·4=32=2⁵이므로 log₂32=5입니다."
              ]
            },
            {
              "type": "answer",
              "title": "답",
              "text": "두 식 모두 5"
            },
            {
              "type": "verification",
              "title": "검산",
              "text": "변형한 식을 지수와 로그의 정의 또는 원래 조건에 대입해 확인합니다."
            }
          ]
        },
        {
          "id": "m10104-practice",
          "template": "practice",
          "title": "연습하고 확인하기",
          "blocks": [
            {
              "type": "question",
              "title": "연습",
              "text": "log₃(81/3)+2log₃(3)을 계산하세요."
            },
            {
              "type": "hint",
              "title": "힌트",
              "text": "곱의 로그를 합으로 바꾸거나 4·8을 2의 거듭제곱으로 쓰세요."
            },
            {
              "type": "solutionStep",
              "title": "해설",
              "items": [
                "log₃(81/3)=log₃27=3입니다.",
                "log₃3=1이므로 2log₃3=2입니다.",
                "두 값을 더하면 5입니다."
              ]
            },
            {
              "type": "answer",
              "title": "정답",
              "text": "5"
            },
            {
              "type": "question",
              "title": "독립 연습",
              "text": "log₃(1/27)을 구하고 3의 거듭제곱으로 확인하세요. 정답: 3⁻³=1/27이므로 −3."
            },
            {
              "type": "activity",
              "activity": {
                "id": "m10104-quiz",
                "kind": "quiz",
                "prompt": "log₂(4·8)은 얼마인가요?",
                "options": [
                  "5",
                  "6",
                  "12"
                ],
                "correct_index": 0,
                "correct_feedback": "log₂4+log₂8=2+3=5입니다.",
                "incorrect_feedback": "곱의 로그를 합으로 바꾸거나 4·8을 2의 거듭제곱으로 쓰세요.",
                "hints": [
                  "곱의 로그를 합으로 바꾸거나 4·8을 2의 거듭제곱으로 쓰세요."
                ]
              }
            }
          ]
        },
        {
          "id": "m10104-summary",
          "template": "summary",
          "title": "핵심 정리",
          "blocks": [
            {
              "type": "summary",
              "title": "로그의 성질과 계산",
              "text": "a>0, a≠1이고 M,N>0일 때 log_a(MN)=log_a M+log_a N, log_a(M/N)=log_a M−log_a N, log_a(M^r)=r log_a M입니다. 이 성질은 log_a M=x를 a^x=M으로 바꾸어 지수법칙을 적용하면 얻습니다. 밑과 진수 조건을 먼저 확인합니다."
            },
            {
              "type": "checklist",
              "title": "스스로 확인",
