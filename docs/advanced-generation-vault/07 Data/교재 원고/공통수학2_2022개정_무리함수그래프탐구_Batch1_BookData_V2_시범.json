  "chapters": [
    {
      "title": "무리함수 그래프와 성질 탐구",
      "standard_codes": [
        "10공수2-03-05"
      ],
      "pages": [
        {
          "id": "radical-open",
          "template": "opening",
          "title": "정의역과 그래프의 시작점을 함께 보기",
          "blocks": [
            {
              "type": "lead",
              "title": "기준 연결",
              "text": "2022 개정 기준 10공수2-03-05: 무리함수의 그래프를 그리고 성질을 탐구합니다."
            },
            {
              "type": "thinking",
              "title": "오늘의 질문",
              "text": "y=√(2x+2)+1의 그래프는 어디서 시작하고, 어느 방향으로 이어질까요?"
            }
          ]
        },
        {
          "id": "radical-concept",
          "template": "concept",
          "title": "제곱근 안의 조건과 그래프 시작점",
          "blocks": [
            {
              "type": "definition",
              "title": "기본형",
              "text": "y=√(ax+b)+c (a≠0)에서 ax+b≥0이어야 하므로 정의역의 경계는 x=−b/a입니다."
            },
            {
              "type": "formula",
              "title": "시작점과 치역",
              "text": "경계에서 제곱근 값은 0이므로 그래프는 (−b/a,c)에서 시작합니다. √값은 0 이상이므로 치역은 y≥c입니다."
            },
            {
              "type": "misconception",
              "title": "계수 부호",
              "text": "a>0이면 경계부터 오른쪽으로, a<0이면 경계부터 왼쪽으로 그래프가 이어집니다."
            }
          ]
        },
        {
          "id": "radical-example",
          "template": "example",
          "title": "함숫값을 계산해 그래프를 그리기",
          "blocks": [
            {
              "type": "question",
              "title": "예제",
              "text": "g(x)=√(2x+2)+1의 정의역, 시작점, g(0)을 구하세요."
            },
            {
              "type": "solutionStep",
              "title": "정의역",
              "text": "2x+2≥0이므로 x≥−1입니다."
            },
            {
              "type": "solutionStep",
              "title": "시작점과 함숫값",
              "text": "x=−1에서 g(−1)=1이므로 시작점은 (−1,1)입니다. g(0)=√2+1≈2.414입니다."
            },
            {
              "type": "answer",
              "title": "그래프 정보",
              "text": "x=−1부터 오른쪽으로 이어지며 y값은 1 이상입니다."
            }
          ]
        },
        {
          "id": "radical-practice",
          "template": "practice",
          "title": "계수 부호에 따른 정의역 비교",
          "blocks": [
            {
              "type": "question",
              "title": "연습",
              "text": "h(x)=√(−x+3)−2의 정의역, 시작점, 치역을 구하세요."
            },
            {
              "type": "solutionStep",
              "title": "풀이",
              "text": "−x+3≥0이므로 x≤3입니다. 경계 x=3에서 함수값은 −2입니다."
            },
            {
              "type": "answer",
              "title": "정답",
              "text": "정의역은 x≤3, 시작점은 (3,−2), 치역은 y≥−2입니다."
            }
          ]
        },
        {
          "id": "radical-explore",
          "template": "experiment",
          "title": "매개변수로 그래프 탐구하기",
          "blocks": [
            {
              "type": "lead",
              "title": "조작 순서",
              "text": "a를 바꾸어 그래프가 시작하는 방향을 비교하고 b로 시작 x좌표, c로 시작 y좌표가 어떻게 달라지는지 확인하세요."
            },
            {
              "type": "activity",
              "activity": {
                "id": "radical-function-explorer-2022",
                "kind": "radicalFunctionExplorer",
                "prompt": "y=√(ax+b)+c의 정의역과 그래프 시작점·치역을 탐구합니다.",
                "hints": [
                  "ax+b=0을 풀어 경계 x를 찾습니다.",
                  "경계에서 y=c이며 제곱근은 음수가 될 수 없습니다."
                ],
                "explorer": {
                  "a_values": [
                    -2,
                    -1,
                    1,
                    2
                  ],
                  "initial_a": 2,
                  "min_b": -2,
                  "max_b": 2,
                  "b_step": 0.5,
                  "initial_b": 2,
                  "min_c": -3,
                  "max_c": 3,
                  "c_step": 0.5,
                  "initial_c": 1
                }
              }
            }
          ]
        },
        {
          "id": "radical-quiz",
          "template": "practice",
          "title": "그래프 시작점 확인",
          "blocks": [
            {
              "type": "question",
              "title": "퀴즈",
              "text": "y=√(2x+2)+1의 그래프 시작점은?"
            },
            {
              "type": "activity",
              "activity": {
                "id": "radical-startpoint-quiz-2022",
                "kind": "quiz",
                "prompt": "y=√(2x+2)+1의 그래프 시작점은?",
                "options": [
                  "(−1,1)",
                  "(1,−1)",
                  "(−2,1)"
                ],
                "correct_index": 0,
                "correct_feedback": "2x+2=0에서 x=−1이고 함수값은 1입니다.",
                "incorrect_feedback": "먼저 제곱근 안이 0이 되는 x를 찾고 바깥의 +1을 반영하세요.",
                "hints": [
                  "2x+2=0을 풉니다.",
                  "경계에서 √0+1을 계산합니다."
                ]
              }
            }
          ]
        },
        {
          "id": "radical-summary",
          "template": "summary",
          "title": "정의역·시작점·치역으로 검산하기",
          "blocks": [
            {
              "type": "summary",
              "title": "핵심 정리",
              "text": "y=√(ax+b)+c는 ax+b≥0인 x에서 정의됩니다. 경계 x=−b/a에서 (−b/a,c)로 시작하며 치역은 y≥c입니다."
            },
            {
              "type": "checklist",
              "title": "스스로 점검",
              "text": "a의 부호로 그래프가 이어지는 방향을 정하고, 시작점과 치역을 그래프와 연결했나요?"
            }
          ]
        }
      ]
    }
  ]
