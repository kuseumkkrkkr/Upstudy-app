              "type": "solutionStep",
              "title": "풀이",
              "text": "θ=s/r=2/4=1/2 rad입니다."
            },
            {
              "type": "answer",
              "title": "정답",
              "text": "θ=s/r=2/4=1/2 rad입니다."
