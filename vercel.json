{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "data/content/**",
      "excludeFiles": "{.dart_tool/**,omj/**,build/**,design/**,lib/**,test/**,tests/**,assets/**,public/**,s11_teacher/**,android/**,ios/**,web/**,windows/**,linux/**,macos/**,scripts/**,tool/**}"
    }
  },
  "headers": [
    {
      "source": "/(index.html|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(health|auth|user|account|rating|arena|weakness|history|courses|academy|challenges|marketplace|analysis|social|textbooks|quests|exams|continue|serverchat|level-tests|graphs|demo|student|api|internal)(/.*)?",
      "dest": "/api/index.py"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
