{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": { "maxDuration": 30 }
  },
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(health|auth|user|account|rating|arena|weakness|history|courses|academy|challenges|marketplace|analysis|social|textbooks|quests|exams|serverchat|api)(/.*)?",
      "dest": "/api/index.py"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
